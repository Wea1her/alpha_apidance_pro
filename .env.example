# Alpha 共同关注推送服务配置模板
# 使用方法：复制为 .env，在 .env 中填写真实配置，然后启动或重启服务。
# 基础推送必填：ALPHA_WALLET_PRIVATE_KEY、TELEGRAM_BOT_TOKEN、TELEGRAM_CHAT_ID。
# 启用账号分类需填写 XAI_API_KEY；在讨论群发布投研还需 DISCUSSION_CHAT_ID。
# 下文“默认”指变量未设置或留空时的程序行为；有固定值的模板项会优先使用该值。
# 时间参数中，*_MS 的单位是毫秒，ALPHA_LISTEN_SECONDS 的单位是秒。
# 私钥、Token 和 API Key 只填写在已被 Git 忽略的 .env 中，不要写入本模板。

# -----------------------------------------------------------------------------
# 1. Alpha 登录与监听
# -----------------------------------------------------------------------------

# 【必填】已获 Alpha 白名单的钱包私钥，通常为 0x 开头的 64 位十六进制字符串。
# 用于签名登录 Alpha；请使用专门的白名单钱包。
ALPHA_WALLET_PRIVATE_KEY=

# Alpha HTTP API 基础地址；默认如下，程序会追加 /v1/login。
ALPHA_BASE_URL=https://alpha.apidance.pro/api

# Alpha WebSocket 基础地址；默认如下，由程序拼接连接路径和登录凭证。
ALPHA_WS_BASE_URL=wss://alpha.apidance.pro/api

# 仅对 npm run alpha:ws 测试监听生效，默认 120 秒；不限制 npm start 的运行时长。
ALPHA_LISTEN_SECONDS=

# WebSocket 接收超时，默认 90000（90 秒）；心跳或业务消息都会刷新计时，超时重连。
ALPHA_HEARTBEAT_TIMEOUT_MS=

# 业务消息静默超时，默认 60000（60 秒）；即使仍有心跳，长期无业务消息也会重连。
ALPHA_BUSINESS_SILENCE_TIMEOUT_MS=

# 历史回放的回看窗口，默认 600000（10 分钟）。
# 仅在可用的历史回放接口接入后生效；当前不能据此补回上游未下发的事件。
ALPHA_REPLAY_LOOKBACK_MS=

# 断线或登录失败后的重连最小等待时间，默认 1000（1 秒）。
ALPHA_RECONNECT_MIN_DELAY_MS=

# 重连最大等待时间，默认 30000（30 秒）。
ALPHA_RECONNECT_MAX_DELAY_MS=

# 共同关注人数对应的星级阈值，正整数、英文逗号分隔，必须严格递增。
# 默认 5,8,12,15,20，分别对应 1～5 星；低于第一个阈值不推送。
COMMON_FOLLOW_STAR_LEVELS=

# -----------------------------------------------------------------------------
# 2. Telegram 频道、讨论群与请求重试
# -----------------------------------------------------------------------------

# 【必填】从 Telegram 的 @BotFather 获取的机器人 Token。
# 机器人需要加入目标频道并拥有发消息权限；使用讨论群时也需要加入该群。
TELEGRAM_BOT_TOKEN=

# 【必填】主推送频道的聊天 ID，通常为 -100 开头的数字，例如 -1001234567890。
TELEGRAM_CHAT_ID=

# 【投研评论需要】主频道已关联的讨论群聊天 ID，通常也以 -100 开头。
# 留空时仍发送频道主消息，但不会在讨论群发布标准分析或深度投研。
DISCUSSION_CHAT_ID=

# Telegram 单次请求的最大尝试次数，包含首次请求，默认 5。
TELEGRAM_RETRY_ATTEMPTS=

# Telegram 请求重试的最小等待时间，默认 1000（1 秒）。
TELEGRAM_RETRY_MIN_DELAY_MS=

# Telegram 请求重试的最大等待时间，默认 30000（30 秒）。
TELEGRAM_RETRY_MAX_DELAY_MS=

# -----------------------------------------------------------------------------
# 3. 失败补发、分析任务与持久化数据
# 相对路径以启动服务时的工作目录为基准；保留这些文件才能恢复状态和补发任务。
# -----------------------------------------------------------------------------

# 主频道消息发送失败后的补发队列，默认 data/failed-messages.jsonl。
FAILED_QUEUE_PATH=

# 主消息补发次数耗尽后的死信文件，默认 data/dead-letter-messages.jsonl。
# 死信保留供排查和人工恢复，不会继续自动补发。
FAILED_QUEUE_DEAD_LETTER_PATH=

# 主消息补发队列的扫描间隔，默认 30000（30 秒）。
FAILED_QUEUE_RETRY_INTERVAL_MS=

# 每条失败主消息的最大补发尝试次数，默认 20；达到上限后转入死信文件。
FAILED_QUEUE_MAX_ATTEMPTS=

# 标准分析及深度投研的任务队列，默认 data/analysis-tasks.jsonl。
# 用于持久化等待讨论群映射、模型重试和消息发送进度等状态。
ANALYSIS_QUEUE_PATH=

# 分析任务重试耗尽后的死信文件，默认 data/analysis-dead-letter.jsonl。
ANALYSIS_QUEUE_DEAD_LETTER_PATH=

# 分析任务队列的重试扫描间隔，默认 30000（30 秒）。
ANALYSIS_QUEUE_RETRY_INTERVAL_MS=

# 单条分析任务的最大重试次数，默认 30；达到上限后转入分析死信文件。
ANALYSIS_QUEUE_MAX_ATTEMPTS=

# 已完成分析的归档文件，默认 data/analysis-archive.jsonl，用于报告恢复、去重及导出。
ANALYSIS_ARCHIVE_PATH=

# 允许使用分析导出命令的 Telegram 用户名，英文逗号分隔，例如 alice,@bob。
# @ 可省略，不区分大小写；与下方聊天 ID 白名单满足任意一项即可授权。
EXPORT_ADMIN_USERNAMES=

# 允许使用分析导出命令的聊天 ID，英文逗号分隔，例如 -1001234567890,-1009876543210。
# 频道消息通常没有发送者用户名，建议配置聊天 ID；两项白名单都留空则不允许导出。
EXPORT_ALLOWED_CHAT_IDS=

# 项目星级、推送次数和首次频道消息引用的状态文件，默认 data/project-state.json。
# 保留该文件可在重启后继续判断升星和重复推送。
PROJECT_STATE_PATH=

# -----------------------------------------------------------------------------
# 4. 网络代理
# -----------------------------------------------------------------------------

# 可选代理地址，例如 http://127.0.0.1:7890，按服务器实际可访问的代理填写。
# 留空时还会尝试系统 HTTPS_PROXY、HTTP_PROXY；这些也未设置时才使用直连。
PROXY_URL=

# -----------------------------------------------------------------------------
# 5. Grok 账号分类与标准投研
# -----------------------------------------------------------------------------

# 【账号分类和标准投研需要】xAI 或兼容中转渠道的 API Key。
# 留空仍可启动基础推送，但无法完成 Grok 账号分类和标准分析。
XAI_API_KEY=

# 接口基础地址，默认 https://api.x.ai；使用中转时填写对应基础地址。
# 不要在末尾添加 /v1 或具体请求路径，程序会追加 /v1/responses 或 /v1/chat/completions。
XAI_BASE_URL=https://api.x.ai

# 账号分类和标准分析共用的模型；本模板使用 grok-4.3。
# 注意：若将此项清空，当前程序会回退为 grok-4.20-fast；请按渠道支持情况填写。
XAI_MODEL=grok-4.3

# Grok 单次请求的最大尝试次数，包含首次请求，默认 5。
# 网络错误、空回复、429 和 5xx 等可重试错误会按此配置重试。
XAI_RETRY_ATTEMPTS=

# Grok 请求重试的最小等待时间，默认 1000（1 秒）。
XAI_RETRY_MIN_DELAY_MS=

# Grok 请求重试的最大等待时间，默认 20000（20 秒）。
XAI_RETRY_MAX_DELAY_MS=

# 标准 Grok 回复的 token 预算，默认 2048；需要更长的分析时可适当调高。
XAI_MAX_TOKENS=

# 标准投研联网检索工具，英文逗号分隔，只支持 web_search 和 x_search。
# 未设置或留空默认同时启用这两项；填 none 关闭。账号分类不使用检索。
# 渠道需支持 Responses API 和对应工具；不支持时可能降级为普通请求并记录警告。
XAI_SEARCH_TOOLS=web_search,x_search

# -----------------------------------------------------------------------------
# 6. 首次五星项目的深度投研（可选独立渠道）
# 使用独立 Key、地址和模型；网络代理及请求重试参数沿用 PROXY_URL、XAI_RETRY_*。
# -----------------------------------------------------------------------------

# 深度投研渠道的独立 API Key，不会自动复用上方 XAI_API_KEY。
# 留空关闭深度投研，已入队的深度任务会保留；开启时还需要配置 DISCUSSION_CHAT_ID。
XAI_DEEP_API_KEY=

# 深度投研接口基础地址，默认如下；同样不要在末尾添加 /v1 或具体请求路径。
XAI_DEEP_BASE_URL=https://api.fengshao1227.com

# 深度投研模型，默认 grok-4.20-multi-agent-0309；不会替换上方标准分析模型。
XAI_DEEP_MODEL=grok-4.20-multi-agent-0309

# 深度投研回复的 token 预算，默认 4096。
XAI_DEEP_MAX_TOKENS=4096

# 深度投研的检索工具，默认 web_search；留空也使用该默认值，填 none 关闭。
# 可用值为 web_search、x_search（英文逗号分隔），实际支持情况取决于深度渠道。
XAI_DEEP_SEARCH_TOOLS=web_search
